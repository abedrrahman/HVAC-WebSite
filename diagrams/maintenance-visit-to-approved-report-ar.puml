@startuml
title زيارة الصيانة: من المكتب إلى التقرير المعتمد

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam ArrowColor #555555
skinparam ArrowFontSize 12
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #8A8F99
skinparam ActivityDiamondBackgroundColor #FFF6E0
skinparam NoteBackgroundColor #F4F6FA
skinparam NoteBorderColor #C6C8D2
skinparam PartitionFontStyle bold

start
partition "المكتب (الموقع)" #FDECF1 {
  if (وحدة واحدة أم عقد كامل؟) then (زيارة واحدة)
    :**بدء الزيارة**
    اضغط الزر واختر الفني;
  else (عقد)
    :**إرسال كل الوحدات إلى فني**
    اضغط الزر واختر الفني والتاريخ ونوع الزيارة;
    note left
      تُستخدم الزيارة المخططة التالية
      لكل وحدة (خلال شهر)
      فلا يحدث أي تكرار
    end note
  endif
  :**قيد التنفيذ**
  تصبح الزيارات قيد التنفيذ ويصل إشعار إلى الفني; <<#E8F0FA>>
}
partition "تطبيق الهاتف (الفني)" #E8F0FA {
  :**زياراتي**
  تظهر الزيارات عند المزامنة التالية
  (خلال دقيقة مع الإنترنت);
  :يعبئ الفني تقريراً لكل وحدة
  (القراءات، الصور، الملاحظات، القطع);
  if (عقد بعدة وحدات؟) then (نعم)
    :**توقيع الكل**
    يوقّع الفني والعميل مرة واحدة لكل الوحدات;
  else (لا)
    :يوقّع الفني والعميل على التقرير;
  endif
  :الرفع عند توفر الإنترنت:
  التقرير + PDF + الصور + التواقيع;
  note left
    الإرسال مرتين آمن:
    رقم التقرير نفسه لا ينشئ
    زيارة ثانية أبداً
  end note
}
partition "الموقع" #F4F6FA {
  if (هل الوحدة موجودة في الموقع؟) then (نعم)
    :**مكتملة**
    تُغلق الزيارة المبدوءة بهذا التقرير;
  else (لا)
    :**التقارير اليومية**
    ينتظر التقرير هنا حتى يُضاف الموقع والوحدة;
  endif
  :**بانتظار رئيس العمال**
  يصل إشعار إلى رؤساء العمال;
}
partition "رئيس العمال" #FFF6E0 {
  :يقرأ التقرير ويصحح القراءات;
  note left
    القراءات الخارجة عن الحدود
    تظهر بالأحمر. كل تعديل يُسجَّل
    مع القيمة القديمة والجديدة
  end note
  :**اعتماد وإرسال إلى المهندس**;
}
partition "المهندس" #DFF3E8 {
  :يصله إشعار، يقرأ التقرير
  ويمكنه تصحيح القراءات;
  :**اعتماد**;
  :**معتمد ومقفل**
  فقط مدير النظام يستطيع تعديله; <<#DFF3E8>>
  :**ملف التقرير المعتمد**
  مع صفحات الهاتف الموقّعة;
  :**إرسال بالبريد**
  يُنزَّل الملف وتفتح مسودة في Outlook;
  note left
    يُسحب ملف PDF إلى الرسالة
    يدوياً: روابط البريد
    لا تحمل مرفقات
  end note
}
stop
@enduml
